import os
import telebot

TOKEN = os.getenv("BOT_TOKEN")

if not TOKEN:
    raise ValueError("BOT_TOKEN is missing")

bot = telebot.TeleBot(TOKEN)

@bot.message_handler(commands=['start'])
def start(message):
    bot.reply_to(
        message,
        "✝️ እንኳን ወደ Likawent AI Bot በደህና መጡ!\n\n"
        "ይህ ቦት ስለ ኢትዮጵያ "
        "ኦርቶዶክስ ተዋሕዶ ትምህርት "
        "እና ቅዱሳን መረጃ ይሰጣል።\n\n"
        "ጥያቄዎን ይጻፉ።"
    )

@bot.message_handler(commands=['help'])
def help_command(message):
    bot.reply_to(
        message,
        "📚 Likawent AI Bot\n\n"
        "ስለሚከተሉት መጠየቅ ይችላሉ፦\n"
        "1. ቅዱሳን\n"
        "2. የቤተክርስቲያን በዓላት\n"
        "3. መጽሐፍ ቅዱስ\n"
        "4. የኦርቶዶክስ ትምህርቶች"
    )

@bot.message_handler(func=lambda message: True)
def reply(message):
    bot.reply_to(
        message,
        "📖 ጥያቄዎን ተቀብያለሁ። "
        "የAI መልስ አገልግሎት በሚቀጥለው "
        "የግንባታ ደረጃ ይጨመራል።"
    )

bot.infinity_polling()
